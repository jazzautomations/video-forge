{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Forge reuse-first storyboard",
  "type": "object",
  "required": [
    "width",
    "height",
    "fps",
    "scenes"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 2
    },
    "height": {
      "type": "integer",
      "minimum": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "seconds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "title",
              "character",
              "screen",
              "three",
              "component"
            ]
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          },
          "props": {
            "type": "object"
          },
          "color": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "sourceWidth": {
            "type": "integer",
            "minimum": 1
          },
          "sourceHeight": {
            "type": "integer",
            "minimum": 1
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "frame",
                "cx",
                "cy",
                "zoom"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "cx": {
                  "type": "number"
                },
                "cy": {
                  "type": "number"
                },
                "zoom": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "narration": {
            "type": "string"
          },
          "closing": {
            "type": "boolean"
          },
          "masks": {
            "type": "array"
          },
          "cursor": {
            "type": "array"
          },
          "component": {
            "type": "string",
            "pattern": "^(onda|rendercomp)/[a-z0-9-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "title"
                }
              }
            },
            "then": {
              "required": [
                "title"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "screen"
                }
              }
            },
            "then": {
              "required": [
                "src",
                "sourceWidth",
                "sourceHeight",
                "keys"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "component"
                }
              }
            },
            "then": {
              "required": [
                "component"
              ]
            }
          }
        ]
      }
    },
    "brand": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "voiceLanguage": {
      "type": "string"
    },
    "music": {
      "type": "boolean"
    }
  }
}
