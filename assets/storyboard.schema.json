{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Forge reuse-first storyboard",
  "type": "object",
  "required": [
    "width",
    "height",
    "fps",
    "scenes"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 2
    },
    "height": {
      "type": "integer",
      "minimum": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "fontFamily": {
      "type": "string",
      "description": "Base font stack for titles, 3D overlays and catalog components. Use a system stack (e.g. 'Arial,sans-serif', 'Georgia,serif', \"'Courier New',monospace\")."
    },
    "titleAdvance": {
      "type": "number",
      "description": "Upper-bound glyph advance (fraction of font size) for the title fit math. 0.54 for Arial/Helvetica; raise for wider fonts (Georgia ~0.56, Verdana ~0.63) so long titles never overflow.",
      "minimum": 0.4,
      "maximum": 0.9
    },
    "transition": {
      "type": "string",
      "description": "Default seam between scenes. Per-scene 'transition' overrides it.",
      "enum": [
        "wipe",
        "push",
        "fade",
        "iris",
        "none"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "seconds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "title",
              "character",
              "screen",
              "three",
              "component"
            ]
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string",
            "description": "Title scene eyebrow label (above headline). Defaults to the brand. Set \"\" to hide it."
          },
          "props": {
            "type": "object"
          },
          "color": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "sourceWidth": {
            "type": "integer",
            "minimum": 1
          },
          "sourceHeight": {
            "type": "integer",
            "minimum": 1
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "frame",
                "cx",
                "cy",
                "zoom"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "cx": {
                  "type": "number"
                },
                "cy": {
                  "type": "number"
                },
                "zoom": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "narration": {
            "type": "string"
          },
          "closing": {
            "type": "boolean"
          },
          "masks": {
            "type": "array"
          },
          "cursor": {
            "type": "array"
          },
          "component": {
            "type": "string",
            "pattern": "^(onda|rendercomp|curvable)/[a-z0-9-]+$"
          },
          "transition": {
            "type": "string",
            "enum": [
              "wipe",
              "push",
              "fade",
              "iris",
              "none"
            ]
          },
          "titleSize": {
            "type": "number"
          },
          "maxTitleSize": {
            "type": "number"
          },
          "anchor": {
            "type": "string",
            "enum": [
              "nw",
              "n",
              "ne",
              "w",
              "c",
              "e",
              "sw",
              "s",
              "se"
            ],
            "description": "Compass anchor for a title scene's block (EditorialTitle): sw=bottom-left, ne=top-right, c=center, w=left (default). Breaks the everything-centered look."
          },
          "rule": {
            "type": "boolean",
            "description": "Title scene: draw the accent rule under the headline (default true). Set false to drop it — vary so eyebrow+rule isn't stamped on every title."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "title"
                }
              }
            },
            "then": {
              "required": [
                "title"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "screen"
                }
              }
            },
            "then": {
              "required": [
                "src",
                "sourceWidth",
                "sourceHeight",
                "keys"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "component"
                }
              }
            },
            "then": {
              "required": [
                "component"
              ]
            }
          }
        ]
      }
    },
    "brand": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "voiceLanguage": {
      "type": "string"
    },
    "music": {
      "type": "boolean"
    },
    "displayFont": {
      "type": "string",
      "description": "CSS font stack for headlines (EditorialTitle). Set by a theme to its DISPLAY font; falls back to fontFamily."
    },
    "textFont": {
      "type": "string",
      "description": "CSS font stack for body/subtitles/components. Set by a theme to its TEXT font; falls back to fontFamily."
    },
    "fonts": {
      "type": "array",
      "description": "Vendored @font-face set the project loads from public/fonts (build_project copies these .woff2). Stamped by compose.py from the theme.",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "weight",
          "file"
        ]
      }
    }
  }
}
